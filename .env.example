# 环境变量示例（复制为 .env.local，勿提交密钥）

# ── LLM / AI 问道与审核（P0，仅服务端；前端无密钥配置入口，避免泄露）──
# 供应商切换（pi-agent-core / pi-ai）：openai-compatible（默认）| deepseek | openai | anthropic | google | openrouter | moonshot
# DZ_LLM_PROVIDER=openai-compatible
DZ_LLM_BASE_URL=https://api.deepseek.com
DZ_LLM_API_KEY=
# 可与各厂官方变量二选一；代码优先 DZ_LLM_API_KEY
# DEEPSEEK_API_KEY= / OPENAI_API_KEY= / ANTHROPIC_API_KEY= / GEMINI_API_KEY= / OPENROUTER_API_KEY= / MOONSHOT_API_KEY=

# 主模型（智能问道、复杂问答）
DZ_LLM_MODEL=deepseek-v4-pro
# 快速模型（划词释义、译文、插图 prompt、UGC 初审）— 未设则用 deepseek-v4-flash
DZ_LLM_MODEL_FAST=deepseek-v4-flash

# 思考模式（DeepSeek 支持时设为 true）
# DZ_LLM_THINKING=true

# 匿名用户每日 AI 次数上限（未设则默认 5）
# DZ_AI_DAILY_QUOTA=5

# ── 开发工具 ────────────────────────────────────────────────
# 生产环境启用低置信度块审核页
# DZ_ENABLE_REVIEW=true
# 生产环境启用缺图排版 demo（/demo/typography）；开发环境默认开启
# DZ_ENABLE_DEMO=1

# ── 账号（Auth.js）──────────────────────────────────────────
AUTH_SECRET=          # openssl rand -base64 32
# NEXTAUTH_SECRET=    # 与 AUTH_SECRET 二选一
# NEXTAUTH_URL=http://localhost:3000

# ── Payload CMS（/admin，与前台 Auth.js 账号分离）──────────
# openssl rand -base64 32
PAYLOAD_SECRET=

# ── PostgreSQL（运行时唯一数据层；不再支持 SQLite）──────────
# 生产必填。建议 Neon/Supabase 的 pooled 连接串。
# 首次部署前务必执行：npm run migrate
DATABASE_URL=postgres://user:password@host/dbname

# 本地跑数据库集成测试用；未设置时 tests/db.test.ts 自动跳过
# 示例（Docker）：postgres://postgres:dz@localhost:55432/daozang_test
DZ_TEST_DATABASE_URL=

# ── 对象存储（生产：Cloudflare R2；本地可用 MinIO）──────────
DZ_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
DZ_S3_BUCKET=daozang-media
DZ_S3_ACCESS_KEY_ID=
DZ_S3_SECRET_ACCESS_KEY=
DZ_S3_REGION=auto
# path-style：本地 MinIO 设 1；未设时也会对 localhost 与 r2.cloudflarestorage.com 自动启用
# DZ_S3_FORCE_PATH_STYLE=1

# 媒体公开访问域名（客户端可见，非密钥）。留空时回退到 public/ 本地文件
# 本地 MinIO 示例：http://127.0.0.1:9000/daozang-media
# 原书扫描 / 网页压缩图走 {该域名}/daozang-images/<部>/<文件>
# 生产已用 Vercel Blob；高清复原 PNG 不上传，留给付费下载
# BLOB_READ_WRITE_TOKEN=   # vercel blob create-store 自动写入
NEXT_PUBLIC_MEDIA_BASE_URL=

# ── 部署区域（决定 UGC 审核策略，见 lib/moderation/policy.ts）──
# global = 海外（默认）；cn = 大陆
DZ_REGION=global
